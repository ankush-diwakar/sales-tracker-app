{
  "cli": {
    "version": ">= 7.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "gradleCommand": ":app:assembleRelease",
        "env": {
          "GRADLE_VERSION": "8.6"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}